@startuml NoteP Project Schema

package "Entities" {
    class User {
        - id: Long
        - name: String
        - surName: String
        - eMail: String
        - password: String
        - pages: List<Page>
        - groups: List<Group>
    }

    class Page {
        - id: Long
        - title: String
        - content: String
        - createdDate: LocalDateTime
        - lastUpdateDate: LocalDateTime
        - user: User
        - group: Group
        - attachments: List<Attachment>
        + addAttachment(attachment: Attachment)
        + removeAttachment(attachment: Attachment)
    }

    class Attachment {
        - id: Long
        - fileName: String
        - fileUrl: String
        - fileType: String
        - fileSize: Long
        - createdTime: LocalDateTime
        - page: Page
    }

    class Group {
        - id: Long
        - name: String
        - password: String
        - members: List<User>
        - pages: List<Page>
    }

    class Conversation {
        - id: Long
        - title: String
        - createdDate: LocalDateTime
        - user: User
        - messages: List<ChatMessage>
        - pages: List<Page>
    }

    class ChatMessage {
        - id: Long
        - role: Role
        - content: String
        - createdDate: LocalDateTime
        - conversation: Conversation
    }

    enum Role {
        USER
        ASSISTANT
    }
}

package "DataAccess" {
    interface UserRepository extends JpaRepository<User, Long> {
        + findByEMail(eMail: String): Optional<User>
        + existsByEMailAndName(email: String, name: String): boolean
        + updatePasswordByEmail(eMail: String, password: String): void  [@Modifying @Query]
    }

    interface PageRepository extends JpaRepository<Page, Long> {
        + findByIdAndUserId(id: Long, userId: Long): Optional<Page>
        + findByUserId(userId: Long): List<Page>
        + findByGroupId(groupId: Long): List<Page>
        + findByUserIdAndGroupId(userId: Long, groupId: Long): List<Page>
        + findByIdAndUserOrGroupMember(pageId: Long, userId: Long): Optional<Page>  [@Query LEFT JOIN group.members]
    }

    interface GroupRepository extends JpaRepository<Group, Long> {
        + findByName(name: String): Optional<Group>
        + findByMembersId(userId: Long): List<Group>
        + existsByIdAndMembersId(groupId: Long, userId: Long): boolean
    }

    interface AttachmentRepository extends JpaRepository<Attachment, Long> {
        + findByPageId(pageId: Long): List<Attachment>
    }

    interface ConversationRepository extends JpaRepository<Conversation, Long> {
        + findByUserIdOrderByCreatedDateDesc(userId: Long): List<Conversation>
        + findByIdAndUserId(id: Long, userId: Long): Optional<Conversation>
    }

    interface ChatMessageRepository extends JpaRepository<ChatMessage, Long> {
        + findByConversationIdOrderByCreatedDateAsc(conversationId: Long, pageable: Pageable): List<ChatMessage>
        + findByConversationIdOrderByCreatedDateAsc(conversationId: Long): List<ChatMessage>
    }
}

package "Bussiness" {
    class UserService {
        - userRepository: UserRepository
        - mapper: UserMapper
        - passwordEncoder: BCryptPasswordEncoder
        - jwtUtil: JWTUtil
        + register(userRequest: UserRequest)
        + logIn(loginRequest: LoginRequest): LoginResponse
        + getById(id: Long): UserResponse
        + deleteById(id: Long)
        + update(userUpdateRequest: UserUpdateRequest)
        + getProfile(): UserResponse
        + loadUserByUsername(username: String): UserDetails
        - getAuthanticatedUser(): User
    }

    class PageService {
        - groupRepository: GroupRepository
        - pageRepository: PageRepository
        - userRepository: UserRepository
        - userMapper: UserMapper
        - pageMapper: PageMapper
        + savePage(pageRequest: PageRequest)
        + getMyPages(): List<PageResponse>
        + updatePage(id: Long, pageRequest: PageRequest)
        + deleteById(id: Long)
        + addToGroup(pageId: Long, groupId: Long)
        + removeFromGroup(pageId: Long)
        + addAttachment(pageId: Long, file: MultipartFile): AttachmentResponse
        + deleteAttachment(pageId: Long, attachmentId: Long)
    }

    class GroupService {
        - groupRepository: GroupRepository
        - pageRepository: PageRepository
        - userRepository: UserRepository
        - userMapper: UserMapper
        - pageMapper: PageMapper
        - groupMapper: GroupMapper
        - passwordEncoder: BCryptPasswordEncoder
        + createGroup(groupRequest: GroupRequest)
        + getMyGroups(): List<GroupResponse>
        + getGroupById(id: Long): GroupResponse
        + getPages(groupId: Long): List<PageResponse>
        + joinGroup(joinRequest: JoinRequest)
        + leaveFromGroup(groupId: Long)
        + updatePageOfGroup(groupId: Long, pageId: Long, pageRequest: PageRequest)
    }

    interface IStorageService {
        + uploadFile(bucketName: String, key: String, file: InputStream, contentType: String): String
        + deleteFile(bucketName: String, key: String)
    }

    class SupabaseServiceImpl implements IStorageService {
        - s3Client: S3Client
        + uploadFile(bucketName: String, key: String, file: InputStream, contentType: String): String
        + deleteFile(bucketName: String, key: String)
    }

    interface IAiService {
        + generateResponse(userMessage: String, contexts: List<Map<String, Object>>, history: List<ChatMessage>): String
    }

    class GeminiServiceImpl implements IAiService {
        - chatModel: ChatModel
        + generateResponse(userMessage: String, contexts: List<Map<String, Object>>, history: List<ChatMessage>): String
    }

    class ChatService {
        - pageRepository: PageRepository
        - userRepository: UserRepository
        - groupRepository: GroupRepository
        - aiService: IAiService
        - conversationRepository: ConversationRepository
        - chatMessageRepository: ChatMessageRepository
        + handleChatWithContext(userMessage: String, pageIds: List<Long>, conversationId: Long): ChatResponse
        + getUserConversations(): List<ConversationSummaryResponse>
        + getConversationMessages(conversationId: Long): List<ChatMessageResponse>
        + deleteConversation(conversationId: Long)
        - getAuthanticatedUser(): User
    }
}

package "DTOs" {
    class UserRequest {
        - name: String
        - surName: String
        - eMail: String
        - password: String
    }

    class UserUpdateRequest {
        - password: String
    }

    class UserResponse {
        - id: Long
        - name: String
        - surName: String
        - eMail: String
    }

    class PageRequest {
        - title: String
        - content: String
    }

    class PageResponse {
        - id: Long
        - title: String
        - content: String
        - groupId: Long
        - ownerId: Long
        - ownerName: String
    }

    interface IMapper<Response, Entity> {
        + toResponse(e: Entity): Response
    }

    class UserMapper implements IMapper<UserResponse, User> {
        + toResponse(u: User): UserResponse
        + toRequest(u: User): UserRequest
        + toResponseList(userList: List<User>): List<UserResponse>
        + toEntity(userRequest: UserRequest): User
    }

    class PageMapper implements IMapper<PageResponse, Page> {
        + toResponse(page: Page): PageResponse
        + toResponseList(pageList: List<Page>): List<PageResponse>
        + toEntity(pageRequest: PageRequest): Page
        + updateEntityWithResponse(page: Page, pageRequest: PageRequest): Page
    }

    class GroupRequest {
        - name: String
        - password: String
    }

    class GroupResponse {
        - id: Long
        - name: String
        - members: List<UserResponse>
        - pages: List<PageResponse>
    }

    class JoinRequest {
        - groupName: String
        - password: String
    }

    class GroupMapper implements IMapper<GroupResponse, Group> {
        - userMapper: UserMapper
        - pageMapper: PageMapper
        + toResponse(group: Group): GroupResponse
        + toResponseList(groupList: List<Group>): List<GroupResponse>
        + toEntity(groupRequest: GroupRequest): Group
    }

    class AttachmentRequest {
        - pageId: Long
        - file: MultipartFile
    }

    class AttachmentResponse {
        - id: Long
        - fileName: String
        - fileUrl: String
        - fileType: String
        - fileSize: Long
        - createdTime: LocalDateTime
    }

    class AttachmentMapper implements IMapper<AttachmentResponse, Attachment> {
        + toResponse(attachment: Attachment): AttachmentResponse
        + toResponseList(attachmentList: List<Attachment>): List<AttachmentResponse>
    }

    record ChatRequest {
        + message: String
        + pageIds: List<Long>
        + conversationId: Long
    }

    record ChatResponse {
        + conversationId: Long
        + response: String
    }

    record ChatMessageResponse {
        + id: Long
        + role: Role
        + content: String
        + createdDate: LocalDateTime
    }

    record ConversationSummaryResponse {
        + id: Long
        + title: String
        + createdDate: LocalDateTime
    }
}

package "Controllers" {
    class UserController {
        - userService: UserService
        + register(userRequest: UserRequest): ResponseEntity<Map<String, String>>
        + login(loginRequest: LoginRequest): ResponseEntity<String>
        + update(userUpdateRequest: UserUpdateRequest): ResponseEntity<Map<String, String>>
        + getProfile(): ResponseEntity<UserResponse>
    }

    class PageController {
        - pageService: PageService
        + save(pageRequest: PageRequest): ResponseEntity<Map<String, String>>
        + getMyPages(): ResponseEntity<List<PageResponse>>
        + updatePage(id: Long, pageRequest: PageRequest): ResponseEntity<Map<String, String>>
        + delete(id: Long): ResponseEntity<Map<String, String>>
        + addToGroup(pageId: Long, groupId: Long): ResponseEntity<Map<String, String>>
        + removeFromGroup(pageId: Long): ResponseEntity<Map<String, String>>
        + addAttachment(pageId: Long, file: MultipartFile): ResponseEntity<AttachmentResponse>
        + deleteAttachment(pageId: Long, attachmentId: Long): ResponseEntity<Map<String, String>>
    }

    class GroupController {
        - groupService: GroupService
        + create(groupRequest: GroupRequest): ResponseEntity<Map<String, String>>
        + getMyGroups(): ResponseEntity<List<GroupResponse>>
        + getGroupById(id: Long): ResponseEntity<GroupResponse>
        + leaveFromGroup(id: Long): ResponseEntity<Map<String, String>>
        + join(joinRequest: JoinRequest): ResponseEntity<Map<String, String>>
        + getPages(id: Long): ResponseEntity<List<PageResponse>>
        + updatePageOfGroup(id: Long, pageId: Long, pageRequest: PageRequest): ResponseEntity<Map<String, String>>
    }

    class ChatController {
        - chatService: ChatService
        + chatWithContext(chatRequest: ChatRequest): ResponseEntity<ChatResponse>
        + getUserConversations(): ResponseEntity<List<ConversationSummaryResponse>>
        + getConversationMessages(id: Long): ResponseEntity<List<ChatMessageResponse>>
        + deleteConversation(id: Long): ResponseEntity<Void>
    }
}

package "ExceptionHandling" {
    class GlobalExceptionHandler {
        + handleRuntimeException(ex: RuntimeException): ResponseEntity<Map<String, Object>>
        + handleIllegalArgumentException(ex: IllegalArgumentException): ResponseEntity<Map<String, Object>>
        + handleGeneralException(ex: Exception): ResponseEntity<Map<String, Object>>
    }
}

package "AuthenticationElements" {
    class JWTUtil {
        - secretKey: SecretKey
        + generateToken(eMail: String): String
        + extractEMail(token: String): String
        + validateToken(token: String, eMail: String): boolean
    }

    class JWTFilter {
        - jwtUtil: JWTUtil
        + doFilterInternal(request: HttpServletRequest, response: HttpServletResponse, filterChain: FilterChain)
    }

    class LoginRequest {
        - eMail: String
        - password: String
    }

    class LoginResponse {
        - token: String
        - message: String
        - user: UserResponse
    }
}

package "Config" {
    class SecurityConfig {
        - jwtFilter: JWTFilter
        + passwordEncoder(): BCryptPasswordEncoder
        + filterChain(http: HttpSecurity): SecurityFilterChain
    }

    class OpenApiConfig {
        - BEARER_AUTH: String
        + notePOpenAPI(): OpenAPI
    }

    class StorageConfig {
        + s3Client(): S3Client
    }
}

package "Application" {
    class NotePApplication {
        + main(args: String[])
    }
}

package "External Framework Types" {
    interface UserDetailsService
    class OncePerRequestFilter
}

UserController --> UserService
UserService --> UserRepository
UserService --> UserMapper
UserService --> JWTUtil
UserService --> BCryptPasswordEncoder
UserService ..|> UserDetailsService

PageController --> PageService
PageService --> GroupRepository
PageService --> PageRepository
PageService --> UserRepository
PageService --> UserMapper
PageService --> PageMapper
PageService --> IStorageService

GroupController --> GroupService
GroupService --> GroupRepository
GroupService --> PageRepository
GroupService --> UserRepository
GroupService --> UserMapper
GroupService --> PageMapper
GroupService --> GroupMapper
GroupService --> BCryptPasswordEncoder

ChatController --> ChatService
ChatService --> PageRepository
ChatService --> UserRepository
ChatService --> GroupRepository
ChatService --> ConversationRepository
ChatService --> ChatMessageRepository
ChatService --> IAiService
IAiService <|.. GeminiServiceImpl
GeminiServiceImpl --> ChatModel
GeminiServiceImpl --> ChatMessage
GeminiServiceImpl --> Role

SupabaseServiceImpl ..|> IStorageService

UserMapper --> UserResponse
UserMapper --> UserRequest
UserMapper --> UserUpdateRequest
UserMapper --> User

PageMapper --> PageResponse
PageMapper --> PageRequest
PageMapper --> Page

GroupMapper --> GroupResponse
GroupMapper --> GroupRequest
GroupMapper --> Group
GroupMapper --> UserMapper
GroupMapper --> PageMapper

AttachmentMapper --> AttachmentResponse
AttachmentMapper --> Attachment

User --> Page : has many
User --> Group : has many
User --> Conversation : has many
Group --> Page : has many
Group --> User : has many

Page --> User : belongs to
Page --> Group : belongs to
Page --> Attachment : has many
Page --> Conversation : referenced in many
Attachment --> Page : belongs to
Conversation --> User : belongs to
Conversation --> ChatMessage : has many
Conversation --> Page : references many
ChatMessage --> Conversation : belongs to
ChatMessage --> Role : uses

GlobalExceptionHandler --> Controllers : advises

JWTFilter --> JWTUtil
JWTFilter --|> OncePerRequestFilter
SecurityConfig --> BCryptPasswordEncoder
SecurityConfig --> JWTFilter
OpenApiConfig --> SecurityConfig : documents bearer auth

legend bottom
== Frontend API Notlari ==

Base URL:
  http://localhost:8081

Genel kurallar:
  - JSON header: Content-Type: application/json
  - /api/auth/register ve /api/auth/login public endpointlerdir.
  - Diger endpointler JWT ister.
  - Login cevabi raw token string doner; frontend bu token'i saklamali.
  - Yetkili isteklerde header:
    Authorization: Bearer <token>
  - CORS aciktir.
  - Swagger/OpenAPI:
    /swagger-ui.html
    /swagger-ui/index.html
    /v3/api-docs

Auth endpointleri:
  POST /api/auth/register
    Body:
      {
        "name": "Ali",
        "surName": "Veli",
        "eMail": "ali@example.com",
        "password": "123456"
      }
    Basarili cevap:
      { "message": "Kullanici olusturuldu." }
    Olasi hata:
      This User Already Existed.

  POST /api/auth/login
    Body:
      {
        "eMail": "ali@example.com",
        "password": "123456"
      }
    Basarili cevap:
      <jwt-token-string>
    Olasi hatalar:
      User not found
      Hatali sifre ya da e-posta!

  PUT /api/auth/update
    Auth: gerekli
    Body:
      {
        "password": "123456"
      }
    Basarili cevap:
      { "message": "Kullanici guncelleme basarili." }
    Aciklama:
      Sifre disindaki alanlar (name, surName, eMail) guncellenemez.
      Kimlik dogrulama JWT token uzerinden yapilir.

  GET /api/auth/me
    Auth: gerekli
    Basarili cevap:
      {
        "id": 1,
        "name": "Ali",
        "surName": "Veli",
        "eMail": "ali@example.com"
      }

Page endpointleri:
  POST /api/pages/save
    Auth: gerekli
    Body:
      {
        "title": "Not basligi",
        "content": "Not icerigi"
      }
    Basarili cevap:
      { "message": "Not olusturma basarili." }

  GET /api/pages/my-list
    Auth: gerekli
    Basarili cevap:
      [
        {
          "id": 1,
          "title": "Not basligi",
          "content": "Not icerigi",
          "groupId": 2,
          "ownerId": 1,
          "ownerName": "Ali"
        }
      ]

  PUT /api/pages/{id}
    Auth: gerekli
    Path parametreleri:
      id: guncellenecek not id
    Body:
      {
        "title": "Yeni baslik",
        "content": "Yeni icerik"
      }
    Basarili cevap:
      { "message": "Update basarili." }
    Olasi hata:
      Page not found

  DELETE /api/pages/{id}
    Auth: gerekli
    Path parametreleri:
      id: silinecek not id
    Basarili cevap:
      { "message": "Silme islemi basarili." }
    Olasi hata:
      GUVENLIK IHLALI: Baskasina ait bir notu silemezsiniz!

  PUT /api/pages/{pageId}/add-to-group/{groupId}
    Auth: gerekli
    Path parametreleri:
      pageId: gruba eklenecek not id
      groupId: hedef grup id
    Basarili cevap:
      { "message": "Not basariyla gruba dahil edildi." }
    Olasi hatalar:
      Page is not exist or You are not owner.
      Group is not found.
      You are not member of this group!

  PUT /api/pages/{pageId}/remove-from-group
    Auth: gerekli
    Path parametreleri:
      pageId: gruptan cikarilacak not id
    Basarili cevap:
      { "message": "Not gruptan cikarildi." }
    Olasi hatalar:
      Page doesn't have a group
      You are not member of this group!

  POST /api/pages/{pageId}/attachments
    Auth: gerekli
    Content-Type: multipart/form-data (field: file)
    Basarili cevap:
      { "id": 1, "fileName": "...", "fileUrl": "...", "fileType": "...", "fileSize": 1024, "createdTime": "..." }
    Olasi hata:
      Not bulunamadi veya bu islem icin yetkiniz yok.

  DELETE /api/pages/{pageId}/attachments/{attachmentId}
    Auth: gerekli
    Basarili cevap:
      { "message": "Dosya Silme Basarili" }
    Olasi hatalar:
      Dosya Bulunamadi.
      Bu dosya belirtilen nota ait degil!

Group endpointleri:
  POST /api/groups/create
    Auth: gerekli
    Body:
      {
        "name": "Grup adi",
        "password": "grupSifresi"
      }
    Basarili cevap:
      { "message": "Grup Olusturma Basarili!" }
    Olasi hata:
      Grup ismi kullanilmis!

  GET /api/groups/my-groups
    Auth: gerekli
    Basarili cevap:
      [
        {
          "id": 1,
          "name": "Grup adi",
          "members": [
            {
              "id": 1,
              "name": "Ali",
              "surName": "Veli",
              "eMail": "ali@example.com"
            }
          ],
          "pages": [
            {
              "id": 1,
              "title": "Not basligi",
              "content": "Not icerigi",
              "groupId": 1,
              "ownerId": 1,
              "ownerName": "Ali"
            }
          ]
        }
      ]

  GET /api/groups/{id}
    Auth: gerekli
    Path parametreleri:
      id: goruntulenecek grup id
    Basarili cevap:
      {
        "id": 1,
        "name": "Grup adi",
        "members": [],
        "pages": []
      }
    Olasi hatalar:
      Grup Bulunamadi!
      GUVENLIK IHLALI: Uyesi olmadiginiz bir grubun icerigini goremezsiniz!

  GET /api/groups/{id}/pages
    Auth: gerekli
    Path parametreleri:
      id: sayfalari goruntulenecek grup id
    Basarili cevap:
      [
        {
          "id": 1,
          "title": "Not basligi",
          "content": "Not icerigi",
          "groupId": 1,
          "ownerId": 1,
          "ownerName": "Ali"
        },
        {
          "id": 3,
          "title": "Diger not",
          "content": "Gruptaki baska bir uyenin notu",
          "groupId": 1,
          "ownerId": 2,
          "ownerName": "Ayse"
        }
      ]
    Olasi hatalar:
      Grup Bulunamadi!
      GUVENLIK IHLALI: Uyesi olmadiginiz bir grubun sayfalarini goremezsiniz!
    Aciklama:
      Bu endpoint gruptaki TUM uyelerin sayfalarini getirir (sadece sayfalar, grup detayi olmadan).
      Kullanici once GET /api/groups/my-groups ile grup listesini alir, bir gruba tikladiginda bu endpoint ile o grubun sayfalarini goruntuler.

  POST /api/groups/join
    Auth: gerekli
    Body:
      {
        "groupName": "Grup adi",
        "password": "grupSifresi"
      }
    Basarili cevap:
      { "message": "Gruba Katilim Basarili!" }
    Olasi hatalar:
      Grup Bulunamadi!
      KULLANICI ZATEN GRUBA UYE!
      YANLIS SIFRE GIRDINIZ!

  DELETE /api/groups/{id}
    Auth: gerekli
    Path parametreleri:
      id: ayrilacak grup id
    Basarili cevap:
      { "message": "Ayrilma islemi basarili." }
    Olasi hatalar:
      This group doesn't exist!
      You are not member

  PUT /api/groups/{id}/pages/{pageId}
    Auth: gerekli
    Path parametreleri:
      id: grup id
      pageId: guncellenecek sayfa id
    Body:
      {
        "title": "Yeni baslik",
        "content": "Yeni icerik"
      }
    Basarili cevap:
      { "message": "Update basarili." }
    Olasi hata:
      You are not member of this group!

AI Chat endpointleri (coklu mesaj destekli):
  POST /api/chat
    Auth: gerekli
    Body (yeni sohbet):
      {
        "message": "Notlar hakkinda ne dusunuyorsun?",
        "pageIds": [1, 2, 3]
      }
    Body (mevcut sohbete devam):
      {
        "message": "Peki ikinci notta ne anlatilmis?",
        "pageIds": [1, 2, 3],
        "conversationId": 42
      }
    Basarili cevap:
      { "conversationId": 42, "response": "AI tarafindan olusturulan yanit..." }
    Aciklama:
      pageIds alani istege baglidir. Bos liste gonderilirse AI genel sohbet yurutur.
      conversationId alani istege baglidir. Bos gonderilirse yeni oturum olusturulur.
      Son 20 mesaj AI'a gecmis olarak iletilir.
      Kullanici kendi notlarina veya uyesi oldugu gruptaki notlara danisabilir.
      Dosya URL'leri multimodal olarak Gemini'ye gonderilir.

  GET /api/chat/conversations
    Auth: gerekli
    Basarili cevap:
      [
        { "id": 1, "title": "Notlar hakkinda...", "createdDate": "2025-06-19T03:00:00" }
      ]
    Aciklama:
      Kullanicinin tum diyalog oturumlarini listeler (yeni->eski).

  GET /api/chat/conversations/{id}
    Auth: gerekli
    Basarili cevap:
      [
        { "id": 1, "role": "USER", "content": "...", "createdDate": "..." },
        { "id": 2, "role": "ASSISTANT", "content": "...", "createdDate": "..." }
      ]
    Aciklama:
      Bir oturumun mesaj gecmisini kronolojik sirayla getirir.
      Yalnizca oturum sahibi erisebilir.

  DELETE /api/chat/conversations/{id}
    Auth: gerekli
    Basarili cevap:
      204 No Content
    Aciklama:
      Bir oturumu ve mesajlarini siler.
      Yalnizca oturum sahibi silebilir.

Validation notlari:
  - UserRequest:
    name zorunlu, max 50
    surName zorunlu, max 50
    eMail zorunlu, email formatinda, max 100
    password zorunlu, min 6, max 100
  - UserUpdateRequest:
    password zorunlu, min 6, max 100
  - PageRequest:
    title zorunlu, max 100
    content zorunlu, max 10000
  - GroupRequest:
    name zorunlu
    password zorunlu
  - JoinRequest:
    groupName zorunlu
    password zorunlu
  - ChatRequest:
    message zorunlu

Hata cevap formati:
  RuntimeException / IllegalArgumentException / SecurityException:
    HTTP 400
    {
      "error": "hata mesaji",
      "status": 400,
      "path": "/api/..."
    }
  Genel Exception:
    HTTP 500
    {
      "error": "Internal Server Error",
      "status": 500,
      "path": "/api/..."
    }
  Token yoksa/gecersizse Spring Security 401/403 donebilir.
endlegend

